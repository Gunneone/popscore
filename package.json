{
  "name": "popscore",
  "description": "See the IMDb rating of any movie by hovering its title on cinema and streaming sites.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && playwright test --project=smoke",
    "e2e:sites": "wxt build && playwright test --project=sites; node scripts/sites-report.mjs",
    "lint:firefox": "wxt build -b firefox && web-ext lint --source-dir dist/firefox",
    "postinstall": "wxt prepare",
    "probe": "node scripts/build-probe.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "server:build": "vite build -c server/vite.config.ts",
    "server:start": "node --env-file-if-exists=.env dist/server/index.mjs",
    "server:dev": "npm run server:build && (vite build -c server/vite.config.ts --watch --logLevel warn & node --env-file-if-exists=.env --watch dist/server/index.mjs)"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
